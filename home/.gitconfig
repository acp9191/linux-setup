[user]
    name = Avery Peterson
    email = 26026736+acp9191@users.noreply.github.com
    # SSH commit signing. The private key stays on the Mac; VMs sign through
    # the forwarded ssh-agent (ForwardAgent yes).
    signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILtHSEV7Lja1XmRrRxNaAIVDlX/6+x8+jMqWAxIanE8n

[commit]
    gpgsign = true

[gpg]
    format = ssh

[gpg "ssh"]
    allowedSignersFile = ~/.config/git/allowed_signers

[init]
    defaultBranch = main

[core]
    editor = vi
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

[pull]
    rebase = true

[rerere]
    enabled = true

[push]
    autoSetupRemote = true
