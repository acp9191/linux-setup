// Managed by linux-setup. Extends the stock 50unattended-upgrades
// (lists here are appended to the defaults, which already cover -security).

// Apply all regular Ubuntu updates, not just security fixes.
Unattended-Upgrade::Allowed-Origins {
    "${distro_id}:${distro_codename}-updates";
};

// Third-party apt repositories added by install.sh.
Unattended-Upgrade::Origins-Pattern {
    "origin=Docker,codename=${distro_codename}";
    "origin=Tailscale";
};

// Clean up packages and kernels that are no longer needed.
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-New-Unused-Dependencies "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Reboot automatically when an update requires it (e.g. a new kernel).
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-Time "04:00";
